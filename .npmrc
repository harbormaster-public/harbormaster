# Ensure optionalDependencies are installed.
#
# Rollup (used by Vite/meteor-vite) relies on platform-specific optional deps like:
# - @rollup/rollup-darwin-arm64
# - @rollup/rollup-darwin-x64
#
# If a developer has `npm config set omit optional`, Rollup's native package
# won't be installed and `npm start` fails with
# "Cannot find module @rollup/rollup-...".
#
# Force optionalDependencies to be installed regardless of user-level omit config.
include=optional
python=/usr/bin/python3

