{
  "name": "harbormaster-io",
  "version": "1.1.6+1.34.0",
  "private": true,
  "scripts": {
    "lint": "bash scripts/lint-working-tree.sh",
    "lint:diff": "bash scripts/lint-changed.sh",
    "lint:all": "bash scripts/lint-all.sh",
    "coverage": "bash scripts/coverage.sh",
    "test": "npm run test:watch -- --once",
    "test:watch": "MOCHA_TIMEOUT=30000 WHEN_USING_OLD_API=1 BROWSERSLIST_IGNORE_OLD_DATA=1 NODE_OPTIONS='--trace-warnings --no-warnings=DeprecationWarning --no-warnings=ExperimentalWarning' ROOT_URL='' MONGO_URL='' NO_HMR=1 meteor test --port=${TEST_PORT:-4040} --driver-package meteortesting:mocha",
    "start": "NODE_OPTIONS='--no-warnings=ExperimentalWarning' NO_HMR=1 meteor run",
    "e2e:server": "E2E=1 NODE_OPTIONS='--no-warnings=ExperimentalWarning' ROOT_URL=http://localhost:4042 NO_HMR=1 meteor run --port 4042 --settings private/e2e-settings.json",
    "cypress:run": "CYPRESS_BASE_URL=http://localhost:4042 cypress run",
    "cypress:open": "CYPRESS_BASE_URL=http://localhost:4042 cypress open",
    "test:e2e": "start-server-and-test e2e:server http://localhost:4042 cypress:run",
    "test:e2e:watch": "start-server-and-test e2e:server http://localhost:4042 cypress:open",
    "reset": "bash scripts/reset.sh",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@babel/runtime": "^7.23.6",
    "ansicolor": "^1.1.100",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.2",
    "chai": "^4.3.7",
    "cleaner": "github:drone1/xolvio-cleaner",
    "d3": "^7.8.5",
    "diskusage": "^1.1.3",
    "expand-tilde": "^1.2.2",
    "faker": "3.1.0",
    "foundation-sites": "^6.8.1",
    "fs-extra": "^11.2.0",
    "get-folder-size": "^5.0.0",
    "is-git-url": "^1.0.0",
    "jquery": "^3.7.0",
    "lodash": "^4.17.21",
    "meteor-node-stubs": "0.2.4",
    "mkdirp": "^0.5.6",
    "motion-ui": "^2.0.5",
    "parse-github-url": "^1.0.2",
    "scroll-to-element": "^2.0.3",
    "semver": "^7.5.4",
    "ssh2": "^1.14.0",
    "tailwindcss": "^3.4.17",
    "tiny-json-http": "^7.5.1",
    "uuid": "^9.0.1",
    "vue": "^3.5.13",
    "vue-d3-network": "^0.1.28",
    "vue-meteor-tracker": "^3.0.0-beta.7",
    "vue-router": "^4.5.0",
    "what-input": "^5.2.12",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@babel/core": "^7.23.6",
    "@babel/eslint-parser": "^7.23.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "autoprefixer": "^10.4.16",
    "c8": "^10.1.3",
    "cypress": "^14.5.2",
    "eslint": "^9.18.0",
    "meteor-vite": "3.8.0",
    "mongodb": "^6.19.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "mocha": "^11.7.5",
    "patch-package": "^8.0.1",
    "postcss": "^8.4.32",
    "postcss-import": "^14.1.0",
    "postcss-load-config": "^2.1.2",
    "start-server-and-test": "^2.1.1",
    "vite": "^6.4.1"
  },
  "meteor": {
    "modern": true,
    "mainModule": {
      "client": "client/entry-meteor.js",
      "server": "server/entry-meteor.js"
    }
  },
  "overrides": {
    "@cypress/request": {
      "qs": "6.14.1"
    }
  }
}
